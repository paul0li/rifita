{
  "name": "rifita",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "compilar": "tsc -p web/tsconfig.json && node --experimental-strip-types scripts/configurar.ts",
    "publicar": "npm run compilar && node --experimental-strip-types scripts/publicar.ts",
    "revisar": "tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.json",
    "servir": "npm run compilar && node --experimental-strip-types web/servir.ts",
    "test": "node --experimental-strip-types --test \"web/tests/**/*.test.ts\"",
    "test:db": "supabase test db",
    "copiar-supabase": "node --experimental-strip-types scripts/copiar-supabase.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
