# Copia este archivo a .env y completa los valores. .env no se versiona.

# Supabase. En local salen de `supabase status` (API URL y la clave
# publishable o anon). Son públicas: la app las manda al navegador.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_CLAVE_PUBLICA=

# Correo que la página de privacidad muestra para pedir el borrado de datos.
CORREO_CONTACTO=

# Puerto del servidor local (npm run servir).
PUERTO=5180
